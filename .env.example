POSTGRES_DB=tenderlens
POSTGRES_USER=tenderlens
POSTGRES_PASSWORD=tenderlens
DATABASE_URL=postgresql+asyncpg://tenderlens:tenderlens@db:5432/tenderlens
DB_DISABLE_PREPARED_STATEMENTS=false
ENVIRONMENT=local
UPLOAD_DIR=/app/data/uploads
STORAGE_PROVIDER=local
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=50
ALLOWED_ORIGINS=http://localhost:3000
DEMO_ACCESS_CODE=
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAX_UPLOAD_MB=10
OLLAMA_BASE_URL=http://host.docker.internal:11434
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
PGVECTOR_SCHEMA=public

