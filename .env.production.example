# Render API
ENVIRONMENT=production
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
DB_DISABLE_PREPARED_STATEMENTS=false
ALLOWED_ORIGINS=https://YOUR-PROJECT.vercel.app
DEMO_ACCESS_CODE=replace-with-a-long-random-code
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=50
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-in-render-only
SUPABASE_STORAGE_BUCKET=tender-pdfs
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
PGVECTOR_SCHEMA=extensions
GEMINI_API_KEY=replace-in-render-only

# Vercel web
NEXT_PUBLIC_API_URL=https://YOUR-API.onrender.com
NEXT_PUBLIC_MAX_UPLOAD_MB=10
